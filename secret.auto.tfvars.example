# Copie para secret.auto.tfvars (gitignored) e preencha.
# Tudo que nao estiver aqui usa o default de variables.tf.

# ── Proxmox (API e host) ────────────────────────────────────────────────────
proxmox_endpoint      = "https://SEU.IP.PUBLICO:8006/api2/json" # IP publico do host; tambem vira alvo do DNS/DNAT/VPN
proxmox_user_name     = "root@pam"
proxmox_user_password = "senha-root"                            # tambem usada no SSH ao host (DNAT, kubeconfig, VPN)
proxmox_node_name     = "pve01"
proxmox_datastore_name = "local"

# ── VMs / cluster k8s ───────────────────────────────────────────────────────
proxmox_vm_user     = "ubuntu"
proxmox_vm_password = "senha-vm"
proxmox_number_of_vm_k8s_control_plane = "3" # 3 = etcd tolera queda de 1 no
proxmox_number_of_vm_k8s_worker_node   = "3"
k8s_control_plane_ip_start             = "50" # control planes: .50, .51, .52
k8s_worker_ip_start                    = "60" # workers: .60, .61, .62

# ── Componentes opcionais (default: todos true) ─────────────────────────────
enable_rancher        = true # UI de gestao em https://rancher.<domain>
enable_metrics_server = true # habilita kubectl top / HPA
enable_vpn            = true # WireGuard no host Proxmox (UDP 51820)

# ── Rancher ─────────────────────────────────────────────────────────────────
rancher_bootstrap_password = "senha-inicial-admin" # pedida no primeiro login

# ── VPN WireGuard ───────────────────────────────────────────────────────────
# Um .conf por nome e gerado em ./vpn/ (gitignored) a cada apply.
vpn_clients = ["erik"]
# Site-to-site com on-premise: preencha os dois quando o roteador de la tiver
# um peer WireGuard apontando para <ip-publico>:51820 (a chave publica do
# server e impressa no final do apply). Vazio = so clientes roadwarrior.
vpn_site_peer_public_key = ""
vpn_site_remote_cidr     = "" # ex: "192.168.0.0/24" (LAN do on-premise)

# ── Dominio / DNS publico (defaults ja apontam para kubepriority) ───────────
# domain      = "kubepriority.com.br"
# gcp_project = "project-90293a0a-5d49-4604-a23"
# dns_zone    = "kubepriority-zone"
# gcp_sa_key_path = "./kubernetes/lets-encrypt-dns-google/cert-manager-dns01.json"
